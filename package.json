{
  "name": "@unityinflow/ai-changelog",
  "version": "0.0.0",
  "description": "AI-aware changelog generator — product and technical changelogs from agent commits and GSD planning files",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ai-changelog": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "format": "prettier --check src/ tests/",
    "format:fix": "prettier --write src/ tests/",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "changelog",
    "ai",
    "gsd",
    "git",
    "release",
    "claude-code"
  ],
  "author": "Jiri Hermann",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/UnityInFlow/ai-changelog.git"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "commander": "^14.0.3",
    "handlebars": "^4.7.9",
    "simple-git": "^3.33.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "execa": "^9.6.1",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
